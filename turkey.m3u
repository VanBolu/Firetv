# ============================================================
# GROUP-TITLE DEĞİŞTİR
# ============================================================

def replace_group(info, group):

    if 'group-title="' in info:

        return re.sub(
            r'group-title="[^"]*"',
            f'group-title="{group}"',
            info
        )

    return info.replace(
        "#EXTINF:-1",
        f'#EXTINF:-1 group-title="{group}"',
        1
    )


# ============================================================
# FAMELACK ÜLKE KODUNU BUL
# ============================================================

def famelack_country(info):

    match = re.search(
        r'group-title="famelack \(([^)]+)\) \[([^\]]+)\]',
        info,
        re.IGNORECASE
    )

    if not match:
        return None

    return match.group(2).lower().strip()


# ============================================================
# DOSYALARI İNDİR
# ============================================================

print("Dünya kanal listesi indiriliyor...")

famelack = download(
    FAMELACK_M3U
)

print("Türkiye kanal listesi indiriliyor...")

turkey = download(
    TURKEY_M3U_SOURCE
)


world_entries = entries(
    famelack
)

turkey_entries = entries(
    turkey
)


# ============================================================
# TURKEY.M3U OLUŞTUR
# ============================================================

print("Türkiye playlisti oluşturuluyor...")

turkey_output = [
    "#EXTM3U"
]

turkey_seen_urls = set()


# Öncelikli kanallar önce

for name, group, url in PRIORITY_CHANNELS:

    info = (
        f'#EXTINF:-1 '
        f'group-title="{group}",'
        f'{name}'
    )

    turkey_output.extend(
        [
            info,
            url
        ]
    )

    turkey_seen_urls.add(
        url
    )


# IPTV-org Türkiye listesindeki diğer kanallar

for info, url in turkey_entries:

    if url in turkey_seen_urls:
        continue

    name = channel_name(
        info
    )

    group = turksat_group(
        name
    )

    info = replace_group(
        info,
        group
    )

    turkey_output.extend(
        [
            info,
            url
        ]
    )

    turkey_seen_urls.add(
        url
    )


TURKEY_OUTPUT.write_text(
    "\n".join(turkey_output) + "\n",
    encoding="utf-8"
)


# ============================================================
# WORLD.M3U OLUŞTUR
# ============================================================

print("Dünya playlisti oluşturuluyor...")

world_output = [
    "#EXTM3U"
]

world_seen_urls = set()


# Önce öncelikli Türkiye kanalları

for name, group, url in PRIORITY_CHANNELS:

    info = (
        f'#EXTINF:-1 '
        f'group-title="{group}",'
        f'{name}'
    )

    world_output.extend(
        [
            info,
            url
        ]
    )

    world_seen_urls.add(
        url
    )


# Famelack dünya kanalları

for info, url in world_entries:

    if url in world_seen_urls:
        continue

    code = famelack_country(
        info
    )

    if code == "tr":

        name = channel_name(
            info
        )

        info = replace_group(
            info,
            turksat_group(name)
        )

    elif code:

        group = COUNTRIES.get(
            code,
            "🌍 " + code.upper()
        )

        info = replace_group(
            info,
            group
        )

    world_output.extend(
        [
            info,
            url
        ]
    )

    world_seen_urls.add(
        url
    )


# Eksik Türkiye kanallarını world.m3u'ya ekle

for info, url in turkey_entries:

    if url in world_seen_urls:
        continue

    name = channel_name(
        info
    )

    info = replace_group(
        info,
        turksat_group(name)
    )

    world_output.extend(
        [
            info,
            url
        ]
    )

    world_seen_urls.add(
        url
    )


WORLD_OUTPUT.write_text(
    "\n".join(world_output) + "\n",
    encoding="utf-8"
)



# ============================================================
# DOSYA İNDİRME
# ============================================================

def download(url):

    request = urllib.request.Request(
        url,
        headers={
            "User-Agent": "Mozilla/5.0"
        }
    )

    with urllib.request.urlopen(
        request,
        timeout=60
    ) as response:

        return response.read().decode(
            "utf-8",
            errors="replace"
        )


# ============================================================
# M3U KAYITLARINI OKU
# ============================================================

def entries(text):

    lines = text.splitlines()
    result = []

    for i, line in enumerate(lines):

        if (
            line.startswith("#EXTINF")
            and i + 1 < len(lines)
        ):

            url = lines[i + 1].strip()

            if url.startswith(
                ("http://", "https://")
            ):

                result.append(
                    (
                        line.strip(),
                        url
                    )
                )

    return result


# ============================================================
# KANAL ADINI AL
# ============================================================

def channel_name(info):

    if "," in info:
        return info.split(",", 1)[1].strip()

    return ""


# ============================================================
# TÜRKÇE KARAKTER NORMALİZASYONU
# ============================================================

def normalize(text):

    text = text.upper()

    replacements = {
        "İ": "I",
        "Ş": "S",
        "Ğ": "G",
        "Ü": "U",
        "Ö": "O",
        "Ç": "C"
    }

    for old, new in replacements.items():

        text = text.replace(
            old,
            new
        )

    text = unicodedata.normalize(
        "NFKD",
        text
    )

    text = "".join(
        c
        for c in text
        if not unicodedata.combining(c)
    )

    return text


# ============================================================
# TÜRKİYE KANAL GRUPLARI
# ============================================================

